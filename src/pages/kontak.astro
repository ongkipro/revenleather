---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/storefront/shared/LegalPage.astro';
import { getTenantLegalPage } from '../data/legal';
import { withStoreName } from '../lib/tenant';
import { getStorePublicContact, getStorePublicFacts } from '../lib/public-store';

const contact = await getStorePublicContact(Astro.locals);
// Reven: COD coverage is read from the store's own settings, not written by hand.
const facts = await getStorePublicFacts(Astro.locals);
const codOffered = facts.payments.some((method) => method.startsWith('COD'));
const codCoverage = !codOffered
  ? 'Sedang tidak tersedia'
  : facts.codExcludedProvinces.length
    ? `Tersedia, kecuali ${facts.codExcludedProvinces.length} provinsi`
    : 'Tersedia ke seluruh Indonesia';
// Reven: the store's WhatsApp, normalised to 62…, with the brand's own number as the fallback.
const normalizedWa = contact.whatsapp ? contact.whatsapp.replace(/^\+/, '').replace(/^0/, '62') : '628518857767';
const data = getTenantLegalPage('contact', Astro.locals.tenant.name, {
  supportWhatsapp: `+${normalizedWa}`,
  supportEmail: contact.email,
  businessAddress: contact.address,
  siteUrl: Astro.locals.tenant.siteUrl,
});
---

<BaseLayout title={withStoreName(data.title, Astro.locals.tenant.name)} description={data.description}>
  <LegalPage
    badge={data.badge}
    title={data.title}
    description={data.description}
    sections={data.sections}
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: data.badge, href: '/kontak' },
    ]}
  >
    <div slot="before" class="mb-4 border border-[#2e241f] bg-[#1a1411] p-5 text-[#faf6f1]">
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#c89b72]">
        Senin – Sabtu · 08.00 – 17.00 WIB
      </p>
      <h2 class="mt-1.5 font-serif text-[20px] font-semibold text-white">
        Hubungi Customer Service Reven Leather
      </h2>
      <p class="mt-1.5 text-[12.5px] leading-[1.65] text-[#cfc2b4]">
        Konsultasi produk kulit sapi asli, konfirmasi nama untuk <strong>Gratis Grafir Laser</strong>, pengecekan resi pengiriman, dan klaim garansi resmi.
      </p>
      <div class="mt-4">
        <a
          href={`https://wa.me/${normalizedWa}?text=${encodeURIComponent('Halo CS Reven Leather, saya ingin bertanya mengenai koleksi produk kulit asli.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 w-full items-center justify-center border border-[#c89b72] bg-[#c89b72] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.1em] text-[#1a1411] transition-colors hover:bg-[#d8ae86]"
        >
          <span>Chat WhatsApp CS (+{normalizedWa})</span>
        </a>
      </div>
    </div>

    <div slot="after" class="mt-4 border border-[#d6cbbd] bg-white p-5">
      <h2 class="font-serif text-[18px] font-semibold text-[#1a1411]">
        Gudang Pengiriman & Pembayaran Resmi
      </h2>
      <dl class="mt-3 divide-y divide-[#efe7dc] text-[12.5px]">
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Jam Operasional CS</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Senin – Sabtu, 08.00 – 17.00 WIB</dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Gudang Utama</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Bululawang, Kab. Malang, Jawa Timur 65171</dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Transfer Bank Resmi</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Bank Mandiri 1330035981794 a.n. PT East Retail Network</dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Layanan COD</dt>
          <dd class="text-right font-semibold text-[#1a1411]">{codCoverage}{codOffered && facts.codExcludedProvinces.length > 0 && <a href="/pengiriman#cod" class="ml-1 font-normal text-[#8a5a3b] underline underline-offset-2">lihat daftar</a>}</dd>
        </div>
      </dl>
    </div>
  </LegalPage>
</BaseLayout>
