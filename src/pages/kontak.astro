---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/storefront/shared/LegalPage.astro';
import { getTenantLegalPage } from '../data/legal';
import { getStoreSupportWhatsapp } from '../lib/public-store';

const supportWhatsapp = await getStoreSupportWhatsapp(Astro.locals);
const normalizedWa = supportWhatsapp ? supportWhatsapp.replace(/^0/, '62').replace(/^\+/, '') : '628518857767';
const data = getTenantLegalPage('contact', Astro.locals.tenant.name, {
  supportWhatsapp: supportWhatsapp ? `+${normalizedWa}` : '+628518857767',
});
---

<BaseLayout title={`${data.title} - ${Astro.locals.tenant.name}`} description={data.description}>
  <LegalPage
    badge={data.badge}
    title={data.title}
    description={data.description}
    sections={data.sections}
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: data.badge, href: '/kontak' },
    ]}
  >
    <div slot="before" class="mb-4 rounded-xl border border-[#3a2d24] bg-[#1a1411] p-5 text-[#faf6f1]">
      <span class="inline-block rounded bg-[#c89b72]/15 px-2 py-0.5 text-[10px] font-bold uppercase tracking-[0.14em] text-[#e2b98f]">
        Respon Cepat · Senin – Sabtu
      </span>
      <h2 class="mt-2 font-serif text-[20px] font-bold text-white">
        Hubungi Customer Service Reven Leather
      </h2>
      <p class="mt-1.5 text-[12.5px] leading-[1.65] text-[#cfc2b4]">
        Tim CS kami siap membantu konsultasi produk kulit sapi asli, konfirmasi nama untuk <strong>Gratis Grafir Laser</strong>, pengecekan resi pengiriman, hingga klaim garansi resmi.
      </p>
      <div class="mt-4 flex flex-col gap-2.5">
        <a
          href={`https://wa.me/${normalizedWa}?text=${encodeURIComponent('Halo CS Reven Leather, saya ingin bertanya mengenai koleksi produk kulit asli.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-[#c89b72] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.12em] text-[#1a1411] transition-colors hover:bg-[#d8ae86]"
        >
          <span>Chat WhatsApp CS (+{normalizedWa})</span>
        </a>
      </div>
    </div>

    <div slot="after" class="mt-4 rounded-xl border border-[#dfd3c3] bg-white p-5 shadow-[0_2px_10px_rgba(26,20,17,0.03)]">
      <h2 class="font-serif text-[18px] font-bold text-[#1a1411]">
        Gudang Pengiriman & Pembayaran Resmi
      </h2>
      <dl class="mt-3 divide-y divide-[#efe7dc] text-[12.5px]">
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Jam Operasional CS</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Senin – Sabtu, 08.00 – 17.00 WIB</dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Gudang Utama</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Bululawang, Kab. Malang, Jawa Timur 65171</dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Transfer Bank Resmi</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Bank Mandiri 1330035981794 a.n. PT East Retail Network</dd>
        </div>
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-[#574c43]">Layanan COD</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Tersedia ke Seluruh Wilayah Indonesia</dd>
        </div>
      </dl>
    </div>
  </LegalPage>
</BaseLayout>
