---
import PageIntro from '../components/storefront/shared/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { footerLegal, footerNavigation } from '../data/site';
import { getStorefrontProducts } from '../lib/catalog';
import { listPublicLandingPages } from '../lib/landing-pages';

const mainLinks = [{ label: 'Beranda (Halaman Depan)', href: '/' }, ...footerNavigation];

// Read from D1 like /sitemap.xml does. This page used to render from compiled
// arrays that are now empty, so it listed no products at all.
const products = await getStorefrontProducts(Astro.locals);
const landingPages = (await listPublicLandingPages(Astro.locals).catch(() => []))
  // A claimed page's own slug only redirects to the product URL, which the
  // product list on this page already carries; listing it here would badge a
  // bouncing link as "Live".
  .filter((page) => !page.isProductPage);
---

<BaseLayout
  shell="storefront"
  title={`Sitemap Halaman - ${Astro.locals.tenant.name}`}
  description={`Daftar lengkap halaman penting website ${Astro.locals.tenant.name} untuk memudahkan penelusuran navigasi.`}
  noindex={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Sitemap', url: '/sitemap' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-[#faf6f1] text-[#1a1411]">
    <PageIntro
      badge="Peta Situs"
      title="Sitemap Halaman"
      description={`Daftar lengkap halaman dan katalog produk ${Astro.locals.tenant.name}.`}
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Sitemap' }]}
    />

    <div class="mx-auto max-w-[480px] space-y-5 px-4 py-6">
      <!-- Section 1: Halaman Utama & Navigasi -->
      <section class="border border-[#d6cbbd] bg-white p-5">
        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#8a5a3b]">
          Navigasi Utama
        </p>
        <h2 class="mt-1 text-[16px] font-semibold text-[#1a1411]">
          Halaman Storefront
        </h2>
        <div class="mt-3.5 divide-y divide-[#ebe3d8] border-t border-[#ebe3d8]">
          {
            mainLinks.map((link) => (
              <a
                href={link.href}
                class="flex items-center justify-between py-2.5 text-[13px] font-medium text-[#1a1411] transition-colors hover:text-[#8a5a3b]"
              >
                <span>{link.label}</span>
                <span class="text-xs text-[#8a7c6f]">→</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Section 2: Katalog Produk -->
      <section class="border border-[#d6cbbd] bg-white p-5">
        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#8a5a3b]">
          Katalog Lengkap
        </p>
        <h2 class="mt-1 text-[16px] font-semibold text-[#1a1411]">
          Daftar Produk ({products.length})
        </h2>

        <div class="mt-3.5 grid grid-cols-2 gap-2 border-t border-[#ebe3d8] pt-3.5">
          {
            products.map((product) => (
              <a
                href={`/produk/${product.slug}`}
                class="border border-[#e2d8cc] bg-[#faf6f1] p-2.5 transition-colors hover:border-[#1a1411] hover:bg-white"
              >
                <p class="truncate text-[9.5px] font-medium uppercase tracking-[0.1em] text-[#7c6a5a]">
                  {product.category}
                </p>
                <p class="mt-0.5 truncate text-[12.5px] font-semibold text-[#1a1411]">
                  {product.productName}
                </p>
              </a>
            ))
          }
        </div>

        {
          landingPages.length > 0 && (
            <div class="mt-4 border-t border-[#ebe3d8] pt-3.5">
              <h3 class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#7c6a5a]">
                Halaman Khusus
              </h3>
              <div class="mt-2 space-y-1.5">
                {
                  landingPages.map((item) => (
                    <a
                      href={item.href}
                      class="flex items-center justify-between border border-[#e2d8cc] bg-[#faf6f1] px-3 py-2 text-[12.5px] font-medium text-[#1a1411] transition-colors hover:border-[#1a1411]"
                    >
                      <span class="truncate">{item.title}</span>
                      <span class="text-xs text-[#8a7c6f]">→</span>
                    </a>
                  ))
                }
              </div>
            </div>
          )
        }
      </section>

      <!-- Section 3: Halaman Legal -->
      <section class="border border-[#d6cbbd] bg-white p-5">
        <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-[#8a5a3b]">
          Dokumen & Kebijakan
        </p>
        <h2 class="mt-1 text-[16px] font-semibold text-[#1a1411]">
          Halaman Legal
        </h2>
        <div class="mt-3.5 divide-y divide-[#ebe3d8] border-t border-[#ebe3d8]">
          {
            footerLegal.map((link) => (
              <a
                href={link.href}
                class="flex items-center justify-between py-2.5 text-[13px] font-medium text-[#1a1411] transition-colors hover:text-[#8a5a3b]"
              >
                <span>{link.label}</span>
                <span class="text-xs text-[#8a7c6f]">→</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- XML sitemap button -->
      <div class="pt-1 text-center">
        <a
          href="/sitemap.xml"
          target="_blank"
          class="inline-flex items-center gap-2 border border-[#1a1411] bg-[#1a1411] px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.1em] text-[#f4eee6] transition-colors hover:bg-[#2c221d]"
        >
          Lihat XML Sitemap (/sitemap.xml)
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
