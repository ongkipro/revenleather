---
import PageIntro from '../../components/storefront/shared/PageIntro.astro';
import ProductListItem from '../../components/storefront/shared/ProductListItem.astro';
import Icon from '../../components/storefront/shared/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatIdr } from '../../lib/format-idr';
import { getStorefrontProducts } from '../../lib/catalog';
import { isApprovedGrafirSlug } from '../../lib/approved-grafir';

const products = await getStorefrontProducts(Astro.locals);
const INITIAL_COUNT = 12;

function resolveCategoryGroup(cat: string): string {
  const c = (cat || '').toLowerCase();
  if (c.includes('dompet') || c.includes('pouch') || c.includes('clucth') || c.includes('clutch') || c.includes('card')) {
    return 'Dompet & Pouch';
  }
  if (c.includes('tas') || c.includes('sling') || c.includes('bag') || c.includes('ransel')) {
    return 'Tas & Sling Bag';
  }
  if (c.includes('sabuk') || c.includes('ikat pinggang') || c.includes('belt')) {
    return 'Ikat Pinggang';
  }
  if (c.includes('gantungan') || c.includes('key') || c.includes('holder')) {
    return 'Gantungan Kunci';
  }
  return 'Lainnya';
}

const categoryOrder = ['Dompet & Pouch', 'Tas & Sling Bag', 'Ikat Pinggang', 'Gantungan Kunci'];
const groupCounts = new Map<string, number>();
let grafirCount = 0;

for (const product of products) {
  const group = resolveCategoryGroup(product.category);
  groupCounts.set(group, (groupCounts.get(group) || 0) + 1);
  if (isApprovedGrafirSlug(product.slug)) {
    grafirCount += 1;
  }
}

const availableGroups = categoryOrder.filter((g) => (groupCounts.get(g) || 0) > 0);
---

<BaseLayout
  title={`Katalog Produk - ${Astro.locals.tenant.name}`}
  description={`Daftar ${products.length} produk kulit sapi asli ${Astro.locals.tenant.name}. Tersedia layanan Gratis Grafir Nama, pembayaran Transfer Bank Mandiri, dan COD.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-[#faf6f1] text-[#1a1411]">
    <PageIntro
      badge={`Katalog · ${products.length} Produk`}
      title={`Produk ${Astro.locals.tenant.name}`}
      description="Pilih produk berdasarkan kategori atau filter produk yang mendukung layanan Gratis Grafir Nama."
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Katalog Produk' }]}
    />

    <section aria-label="Daftar produk" class="mx-auto max-w-[480px] px-4 py-6">
      {products.length > 0 ? (
        <>
          <div class="mb-4 space-y-2.5">
            <div class="relative">
              <input
                id="produk-page-search"
                type="search"
                placeholder="Cari dompet, tas selempang, ikat pinggang..."
                aria-label="Cari produk kulit asli"
                class="w-full rounded-lg border border-[#dfd3c3] bg-white py-2.5 pl-9 pr-3 text-[12px] text-[#1a1411] placeholder:text-[#9c8d7e] focus:border-[#8a5a3b] focus:outline-none"
              />
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#8a5a3b]"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </div>

            <div
              class="flex items-center gap-1.5 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
              role="tablist"
              aria-label="Filter kategori produk"
            >
              <button
                type="button"
                data-page-filter="all"
                class="page-cat-pill shrink-0 cursor-pointer rounded-full border border-[#1a1411] bg-[#1a1411] px-3 py-1.5 text-[11px] font-semibold text-[#faf6f1] transition-colors"
              >
                Semua ({products.length})
              </button>
              {grafirCount > 0 && (
                <button
                  type="button"
                  data-page-filter="grafir"
                  class="page-cat-pill shrink-0 cursor-pointer rounded-full border border-[#dfd3c3] bg-[#f4eee6] px-3 py-1.5 text-[11px] font-semibold text-[#6e452b] transition-colors hover:border-[#c89b72]"
                >
                  Gratis Grafir ({grafirCount})
                </button>
              )}
              {availableGroups.map((group) => (
                <button
                  type="button"
                  data-page-filter={group}
                  class="page-cat-pill shrink-0 cursor-pointer rounded-full border border-[#dfd3c3] bg-white px-3 py-1.5 text-[11px] font-medium text-[#574c43] transition-colors hover:border-[#c89b72] hover:text-[#1a1411]"
                >
                  {group} ({groupCounts.get(group)})
                </button>
              ))}
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3" id="product-grid">
            {products.map((product, index) => {
              const group = resolveCategoryGroup(product.category);
              const isGrafir = isApprovedGrafirSlug(product.slug);
              return (
                <div
                  class={`product-card-item ${index >= INITIAL_COUNT ? 'hidden' : ''}`}
                  data-index={index}
                  data-group={group}
                  data-grafir={isGrafir ? '1' : '0'}
                  data-name={(product.productName || '').toLowerCase()}
                >
                  <ProductListItem product={product} formatPrice={formatIdr} eager={index < 4} />
                </div>
              );
            })}
          </div>

          <div id="page-empty-filter" class="hidden rounded-xl border border-[#dfd3c3] bg-white p-6 text-center">
            <p class="text-[13px] font-semibold text-[#1a1411]">Produk tidak ditemukan</p>
            <p class="mt-1 text-[11px] text-[#574c43]">Coba kata kunci lain atau pilih kategori Semua.</p>
          </div>

          {products.length > INITIAL_COUNT && (
            <div class="mt-7 flex flex-col items-center gap-3" id="load-more-container">
              <p class="text-[11px] font-normal text-[#574c43]">
                Menampilkan <span id="visible-count" class="font-semibold text-[#1a1411]">{Math.min(INITIAL_COUNT, products.length)}</span> dari <span id="total-count" class="font-semibold text-[#1a1411]">{products.length}</span> produk
              </p>
              <button
                id="load-more-btn"
                type="button"
                class="inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border border-[#1a1411] bg-[#1a1411] px-6 py-2.5 text-[11px] font-bold uppercase tracking-[0.1em] text-[#faf6f1] transition-colors hover:bg-[#2d221c] active:scale-[0.99]"
              >
                <span>Tampilkan Produk Lainnya</span>
                <Icon name="lucide:chevron-down" class="h-4 w-4 text-[#e2b98f]" aria-hidden="true" />
              </button>
            </div>
          )}
        </>
      ) : (
        <div class="rounded-xl border border-[#dfd3c3] bg-white py-10 text-center">
          <h2 class="text-lg font-semibold text-[#1a1411]">Katalog sedang disiapkan</h2>
          <p class="mt-2 text-sm leading-6 text-[#574c43]">Produk akan muncul setelah konten dan varian diterbitkan.</p>
        </div>
      )}
    </section>
  </main>

  <script>
    const INITIAL_COUNT = 12;
    const STEP = 12;
    let currentLimit = INITIAL_COUNT;
    let activeFilter = 'all';
    let searchQuery = '';

    const items = Array.from(document.querySelectorAll<HTMLElement>('.product-card-item'));
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreContainer = document.getElementById('load-more-container');
    const visibleCountEl = document.getElementById('visible-count');
    const totalCountEl = document.getElementById('total-count');
    const emptyStateEl = document.getElementById('page-empty-filter');
    const searchInput = document.getElementById('produk-page-search') as HTMLInputElement | null;
    const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('.page-cat-pill'));

    function setPillActive(targetFilter: string) {
      pills.forEach((pill) => {
        const isSelected = pill.dataset.pageFilter === targetFilter;
        if (isSelected) {
          pill.className =
            'page-cat-pill shrink-0 cursor-pointer rounded-full border border-[#1a1411] bg-[#1a1411] px-3 py-1.5 text-[11px] font-semibold text-[#faf6f1] transition-colors';
        } else if (pill.dataset.pageFilter === 'grafir') {
          pill.className =
            'page-cat-pill shrink-0 cursor-pointer rounded-full border border-[#dfd3c3] bg-[#f4eee6] px-3 py-1.5 text-[11px] font-semibold text-[#6e452b] transition-colors hover:border-[#c89b72]';
        } else {
          pill.className =
            'page-cat-pill shrink-0 cursor-pointer rounded-full border border-[#dfd3c3] bg-white px-3 py-1.5 text-[11px] font-medium text-[#574c43] transition-colors hover:border-[#c89b72] hover:text-[#1a1411]';
        }
      });
    }

    function applyFilter() {
      const matched = items.filter((el) => {
        const group = el.dataset.group || '';
        const isGrafir = el.dataset.grafir === '1';
        const name = el.dataset.name || '';
        const matchesCat =
          activeFilter === 'all'
            ? true
            : activeFilter === 'grafir'
              ? isGrafir
              : group === activeFilter;
        const matchesQuery = !searchQuery || name.includes(searchQuery);
        return matchesCat && matchesQuery;
      });

      items.forEach((el) => el.classList.add('hidden'));
      const shown = matched.slice(0, currentLimit);
      shown.forEach((el) => el.classList.remove('hidden'));

      if (visibleCountEl) visibleCountEl.textContent = String(shown.length);
      if (totalCountEl) totalCountEl.textContent = String(matched.length);
      if (emptyStateEl) emptyStateEl.classList.toggle('hidden', matched.length > 0);
      if (loadMoreContainer) {
        loadMoreContainer.classList.toggle('hidden', matched.length <= currentLimit);
      }
    }

    const params = new URLSearchParams(window.location.search);
    const urlFilter = params.get('filter');
    if (urlFilter) {
      activeFilter = urlFilter;
      currentLimit = 100;
      setPillActive(activeFilter);
      applyFilter();
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeFilter = pill.dataset.pageFilter || 'all';
        currentLimit = INITIAL_COUNT;
        setPillActive(activeFilter);
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        currentLimit = INITIAL_COUNT;
        applyFilter();
      });
    }

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        currentLimit += STEP;
        applyFilter();
      });
    }
  </script>
</BaseLayout>
