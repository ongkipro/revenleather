---
import PageIntro from '../components/storefront/shared/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStorePublicFacts, joinIndonesian } from '../lib/public-store';
// Reven: the payment line is read from the checkout's own settings.
const facts = await getStorePublicFacts(Astro.locals);
---

<BaseLayout
  shell="storefront"
  title={`Tentang ${Astro.locals.tenant.name}`}
  description={`Profil resmi ${Astro.locals.tenant.name} (PT East Retail Network). Produsen dompet, tas, dan ikat pinggang kulit sapi asli di Kabupaten Malang, Jawa Timur.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Tentang Kami', url: '/tentang' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-[#faf6f1] text-[#1a1411]">
    <PageIntro
      badge="Profil Resmi"
      title={`Tentang ${Astro.locals.tenant.name}`}
      description="Informasi produk, standar material kulit sapi asli, layanan grafir nama, dan operasional pengiriman Reven Leather."
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Tentang Kami' }]}
    />

    <section class="mx-auto max-w-[480px] space-y-5 px-4 py-6">
      <article class="border border-[#d6cbbd] bg-white p-5">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#7c6a5a]">
          Material & Produksi
        </p>
        <h2 class="mt-1.5 font-serif text-[20px] font-semibold leading-[1.2] text-[#1a1411]">
          100% Kulit Sapi Asli dari Kabupaten Malang, Jawa Timur
        </h2>
        <div class="mt-3 space-y-3 text-[13px] leading-[1.7] text-[#574c43]">
          <p>
            <strong>{Astro.locals.tenant.name}</strong> memproduksi tas selempang, handbag, clutch, dompet, dan ikat pinggang berbahan 100% kulit sapi asli yang berbasis di Kabupaten Malang, Jawa Timur.
          </p>
          <p>
            Bahan yang digunakan meliputi kulit sapi jenis <em>Full-Grain</em>, <em>Pull-Up</em>, <em>Crazy Horse</em>, <em>Nappa</em>, dan <em>Mill Leather</em> yang memiliki ketahanan tinggi dan tidak mudah mengelupas seperti bahan sintetis (PU).
          </p>
        </div>
      </article>

      <div class="grid grid-cols-2 gap-2.5">
        <div class="border border-[#d6cbbd] bg-white p-4">
          <p class="font-serif text-[17px] font-semibold text-[#8a5a3b]">100% Kulit Sapi</p>
          <p class="mt-1 text-[12px] font-semibold text-[#1a1411]">Material Asli</p>
          <p class="mt-1 text-[11px] leading-[1.55] text-[#574c43]">
            Menggunakan lembaran kulit sapi asli dengan aksesoris resleting dan kancing logam.
          </p>
        </div>
        <div class="border border-[#d6cbbd] bg-white p-4">
          <p class="font-serif text-[17px] font-semibold text-[#8a5a3b]">33 Produk</p>
          <p class="mt-1 text-[12px] font-semibold text-[#1a1411]">Gratis Grafir Nama</p>
          <p class="mt-1 text-[11px] leading-[1.55] text-[#574c43]">
            Layanan ukir laser nama atau inisial gratis pada 33 produk bertanda Gratis Grafir.
          </p>
        </div>
        <div class="border border-[#d6cbbd] bg-white p-4">
          <p class="font-serif text-[17px] font-semibold text-[#8a5a3b]">1 Tahun</p>
          <p class="mt-1 text-[12px] font-semibold text-[#1a1411]">Garansi Resmi</p>
          <p class="mt-1 text-[11px] leading-[1.55] text-[#574c43]">
            Garansi 1 tahun mencakup keaslian bahan kulit, jahitan, dan fungsi resleting.
          </p>
        </div>
        <div class="border border-[#d6cbbd] bg-white p-4">
          <p class="font-serif text-[17px] font-semibold text-[#8a5a3b]">Malang</p>
          <p class="mt-1 text-[12px] font-semibold text-[#1a1411]">Gudang Pengiriman</p>
          <p class="mt-1 text-[11px] leading-[1.55] text-[#574c43]">
            Dikirim langsung dari Gudang Utama Bululawang, Kab. Malang ke seluruh Indonesia.
          </p>
        </div>
      </div>

      <article class="border border-[#2e241f] bg-[#1a1411] p-5 text-[#faf6f1]">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#c89b72]">
          Ketentuan Layanan Grafir
        </p>
        <h2 class="mt-1.5 font-serif text-[19px] font-semibold text-white">
          Gratis Grafir Laser Nama di 33 Produk Pilihan
        </h2>
        <p class="mt-2 text-[12.5px] leading-[1.65] text-[#cfc2b4]">
          Layanan ukir laser nama atau inisial diberikan tanpa biaya tambahan untuk <strong>33 produk</strong> yang memiliki label <strong>Gratis Grafir</strong>. Pesanan dengan grafir nama dibayar di muka dengan <strong>QRIS, Virtual Account, atau transfer bank</strong> (non-COD).
        </p>
        <div class="mt-4">
          <a
            href="/produk?filter=grafir"
            class="inline-flex min-h-10 items-center justify-center border border-[#c89b72] bg-[#c89b72] px-4 py-2 text-[11px] font-bold uppercase tracking-[0.1em] text-[#1a1411] transition-colors hover:bg-[#d8ae86]"
          >
            Lihat 33 Produk Gratis Grafir
          </a>
        </div>
      </article>

      <article class="border border-[#d6cbbd] bg-white p-5">
        <h2 class="font-serif text-[18px] font-semibold text-[#1a1411]">
          Identitas Perusahaan & Operasional
        </h2>
        <dl class="mt-3 divide-y divide-[#efe7dc] text-[12.5px]">
          <div class="flex justify-between gap-4 py-2.5">
            <dt class="text-[#574c43]">Nama Brand</dt>
            <dd class="text-right font-semibold text-[#1a1411]">Reven Leather Official</dd>
          </div>
          <div class="flex justify-between gap-4 py-2.5">
            <dt class="text-[#574c43]">Badan Usaha</dt>
            <dd class="text-right font-semibold text-[#1a1411]">PT East Retail Network</dd>
          </div>
          <div class="flex justify-between gap-4 py-2.5">
            <dt class="text-[#574c43]">Gudang Utama</dt>
            <dd class="text-right font-semibold text-[#1a1411]">Bululawang, Kab. Malang, Jawa Timur 65171</dd>
          </div>
          <div class="flex justify-between gap-4 py-2.5">
            <dt class="text-[#574c43]">Metode Pembayaran</dt>
            <dd class="text-right font-semibold text-[#1a1411]">{joinIndonesian(facts.payments) || 'Ditampilkan di formulir pemesanan'}</dd>
          </div>
        </dl>
      </article>
    </section>
  </main>
</BaseLayout>
