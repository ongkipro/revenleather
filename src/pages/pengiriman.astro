---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/storefront/shared/LegalPage.astro';
import { getTenantLegalPage } from '../data/legal';

const data = getTenantLegalPage('shipping', Astro.locals.tenant.name);
---

<BaseLayout title={`${data.title} - ${Astro.locals.tenant.name}`} description={data.description}>
  <LegalPage
    badge={data.badge}
    title={data.title}
    description={data.description}
    sections={data.sections}
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: data.badge, href: '/pengiriman' },
    ]}
  >
    <div slot="before" class="mb-4 rounded-xl border border-[#dfd3c3] bg-white p-5 shadow-[0_2px_10px_rgba(26,20,17,0.03)]">
      <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-[#8a5a3b]">
        Ringkasan Logistik Resmi
      </span>
      <h2 class="mt-1 font-serif text-[19px] font-bold text-[#1a1411]">
        Pengiriman Langsung dari Gudang Utama Malang
      </h2>
      <dl class="mt-3 divide-y divide-[#efe7dc] text-[12.5px]">
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Lokasi Gudang</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Bululawang, Kab. Malang, Jawa Timur 65171</dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Mitra Ekspedisi</dt>
          <dd class="text-right font-semibold text-[#1a1411]">JNE, J&T, SiCepat, SAP, ID Express, Lion, POS</dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Metode Pembayaran</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Transfer Bank Mandiri & COD (Bayar di Tempat)</dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Pesanan Gratis Grafir</dt>
          <dd class="text-right font-semibold text-[#8a5a3b]">Khusus Pembayaran Non-COD (Transfer Bank)</dd>
        </div>
      </dl>
    </div>
  </LegalPage>
</BaseLayout>
