---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/storefront/shared/LegalPage.astro';
import { getTenantLegalPage } from '../data/legal';
import { withStoreName } from '../lib/tenant';
import { getStorePublicContact, getStorePublicFacts, joinIndonesian } from '../lib/public-store';

const contact = await getStorePublicContact(Astro.locals);
// Reven: couriers, payment methods and COD coverage come from the same settings
// the checkout reads, so this summary cannot drift from what a buyer is offered.
const facts = await getStorePublicFacts(Astro.locals);
const nonCodPayments = facts.payments.filter((method) => !method.startsWith('COD'));
const codOffered = nonCodPayments.length < facts.payments.length;
const data = getTenantLegalPage('shipping', Astro.locals.tenant.name, {
  supportWhatsapp: contact.whatsapp,
  supportEmail: contact.email,
  businessAddress: contact.address,
  siteUrl: Astro.locals.tenant.siteUrl,
});
---

<BaseLayout title={withStoreName(data.title, Astro.locals.tenant.name)} description={data.description}>
  <LegalPage
    badge={data.badge}
    title={data.title}
    description={data.description}
    sections={data.sections}
    breadcrumbs={[
      { label: 'Beranda', href: '/' },
      { label: data.badge, href: '/pengiriman' },
    ]}
  >
    <div slot="before" class="mb-4 border border-[#d6cbbd] bg-white p-5">
      <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#7c6a5a]">
        Ringkasan Logistik Resmi
      </p>
      <h2 class="mt-1 font-serif text-[19px] font-semibold text-[#1a1411]">
        Pengiriman Langsung dari Gudang Utama Malang
      </h2>
      <dl class="mt-3 divide-y divide-[#efe7dc] text-[12.5px]">
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Lokasi Gudang</dt>
          <dd class="text-right font-semibold text-[#1a1411]">Bululawang, Kab. Malang, Jawa Timur 65171</dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Mitra Ekspedisi</dt>
          <dd class="text-right font-semibold text-[#1a1411]">{joinIndonesian(facts.couriers) || 'Dipilih otomatis di formulir pemesanan'}</dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Metode Pembayaran</dt>
          <dd class="text-right font-semibold text-[#1a1411]">{joinIndonesian(facts.payments) || 'Ditampilkan di formulir pemesanan'}</dd>
        </div>
        <div class="flex justify-between gap-4 py-2">
          <dt class="text-[#574c43]">Pesanan Gratis Grafir</dt>
          <dd class="text-right font-semibold text-[#8a5a3b]">{nonCodPayments.length ? `Khusus ${joinIndonesian(nonCodPayments)}` : 'Khusus pembayaran non-COD'}</dd>
        </div>
        {codOffered && facts.codExcludedProvinces.length > 0 && (
          <div id="cod" class="flex justify-between gap-4 py-2">
            <dt class="shrink-0 text-[#574c43]">COD tidak tersedia ke</dt>
            <dd class="text-right font-semibold text-[#1a1411]">{joinIndonesian(facts.codExcludedProvinces)}</dd>
          </div>
        )}
      </dl>
    </div>
  </LegalPage>
</BaseLayout>
