---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/storefront/shared/PageIntro.astro';
import { getStorefrontProducts } from '../lib/catalog';
import { getRuntimeEnv } from '../lib/env';
import { cardImageSrc } from '../lib/image-derivative';

const products = await getStorefrontProducts(Astro.locals);

interface AggregatedReview {
  author: string;
  city: string;
  variant: string;
  rating: number;
  comment: string;
  productName: string;
  productSlug: string;
  productImage: string;
  category: string;
}

const allReviews: AggregatedReview[] = [];

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
if (database?.prepare) {
  try {
    const res = await database
      .prepare(
        `SELECT lp.slug, ls.content_html
         FROM landing_sections ls
         INNER JOIN landing_pages lp ON lp.id = ls.landing_page_id
         WHERE ls.type = 'html' AND lp.is_active = 1 AND ls.content_html LIKE '%class="rcard"%'
         LIMIT 40`,
      )
      .all<{ slug: string; content_html: string }>();

    const productBySlug = new Map(products.map((p) => [p.slug, p]));
    for (const row of res.results ?? []) {
      const prod = productBySlug.get(row.slug) || productBySlug.get(row.slug.replace(/^reven-/, ''));
      if (!prod) continue;
      const cards = row.content_html.match(/<article class="rcard">[\s\S]*?<\/article>/g) ?? [];
      const firstCard = cards[0];
      if (!firstCard) continue;
      const authorMatch = firstCard.match(/<div class="ruser"><span>([^<]+)<\/span>/);
      const cityMatch = firstCard.match(/<span class="rcity">([^<]+)<\/span>/);
      const varMatch = firstCard.match(/<span class="rvar">(?:<i[^>]*><\/i>)?([^<]+)<\/span>/);
      const textMatch = firstCard.match(/<p class="rtext">([^<]+)<\/p>/);
      if (authorMatch && textMatch) {
        allReviews.push({
          author: authorMatch[1].trim(),
          city: (cityMatch?.[1] || '').replace(/^[•·\s]+/, '').trim(),
          variant: (varMatch?.[1] || '').trim(),
          rating: 5,
          comment: textMatch[1].replace(/^[“"]+|[”"]+$/g, '').trim(),
          productName: prod.productName,
          productSlug: prod.slug,
          productImage: prod.heroImage || prod.image || '',
          category: prod.category,
        });
      }
    }
  } catch {
    // Fallback to product.reviews if D1 query fails
  }
}

if (allReviews.length === 0) {
  for (const product of products) {
    for (const rev of product.reviews || []) {
      if (rev.comment && rev.name) {
        allReviews.push({
          author: rev.name,
          city: rev.location || '',
          variant: '',
          rating: rev.rating || 5,
          comment: rev.comment,
          productName: product.productName,
          productSlug: product.slug,
          productImage: product.heroImage || product.image || '',
          category: product.category,
        });
      }
    }
  }
}

const displayedReviews = allReviews.slice(0, 36);
---

<BaseLayout
  shell="storefront"
  title={`Ulasan Pembeli - ${Astro.locals.tenant.name}`}
  description={`Daftar ulasan pembeli produk kulit sapi asli ${Astro.locals.tenant.name}.`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Ulasan Pembeli', url: '/testimoni' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-[#faf6f1] text-[#1a1411]">
    <PageIntro
      badge="Ulasan Pembeli"
      title={`Ulasan Pembeli ${Astro.locals.tenant.name}`}
      description="Ulasan dari pembeli produk tas, dompet, dan ikat pinggang kulit sapi asli Reven Leather."
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Ulasan Pembeli' }]}
    />

    <section class="mx-auto max-w-[480px] px-4 py-6">
      <!-- Rating Summary Banner -->
      <div class="mb-5 flex items-center justify-between gap-4 border border-[#d6cbbd] bg-white p-4">
        <div>
          <div class="flex items-baseline gap-2">
            <span class="font-serif text-[32px] font-semibold leading-none text-[#1a1411]">4.9</span>
            <span class="text-[12px] font-semibold text-[#8a5a3b]">/ 5.0</span>
          </div>
          <div class="mt-1 flex items-center gap-0.5 text-[#d97706]" aria-label="Rating 4.9 dari 5 bintang">
            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
          </div>
          <p class="mt-1 text-[11px] text-[#574c43]">
            Menampilkan <strong>{displayedReviews.length}</strong> ulasan pilihan dari 79 produk
          </p>
        </div>
        <div class="border border-[#e8dfd3] bg-[#faf6f1] px-3 py-2.5 text-right">
          <div class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#1a1411]">
            <span>Official Store</span>
            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
              <path
                fill="#1d9bf0"
                d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z"
              />
              <path
                fill="#ffffff"
                d="M10.54 16.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"
              />
            </svg>
          </div>
          <p class="mt-0.5 text-[10px] text-[#574c43]">100% Kulit Sapi Asli</p>
          <p class="text-[10px] text-[#8a5a3b]">Garansi Resmi 1 Tahun</p>
        </div>
      </div>

      <!-- Review List -->
      <div class="space-y-3">
        {displayedReviews.map((rev) => (
          <article class="border border-[#d6cbbd] bg-white p-4">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5">
                <span class="text-[12.5px] font-semibold text-[#1a1411]">{rev.author}</span>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 shrink-0" aria-hidden="true">
                  <path
                    fill="#1d9bf0"
                    d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z"
                  />
                  <path
                    fill="#ffffff"
                    d="M10.54 16.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"
                  />
                </svg>
                {rev.city && <span class="text-[10.5px] text-[#76685b]">· {rev.city}</span>}
              </div>
              <div class="flex items-center gap-0.5 text-[11px] text-[#d97706]">
                {Array.from({ length: rev.rating }).map(() => (
                  <span>★</span>
                ))}
              </div>
            </div>

            {rev.variant && (
              <p class="mt-1 text-[10.5px] font-medium text-[#8a5a3b]">{rev.variant}</p>
            )}

            <p class="mt-2 text-[12.5px] leading-[1.65] text-[#574c43]">
              “{rev.comment}”
            </p>

            <a
              href={`/produk/${rev.productSlug}`}
              class="mt-3 flex items-center gap-2.5 border border-[#e8dfd3] bg-[#faf6f1] p-2 transition-colors hover:border-[#1a1411]"
            >
              {rev.productImage && (
                <img
                  src={cardImageSrc(rev.productImage)}
                  alt={rev.productName}
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                  class="size-9 shrink-0 border border-[#d6cbbd] bg-white object-cover"
                />
              )}
              <div class="min-w-0 flex-1">
                <p class="truncate text-[11px] font-semibold text-[#1a1411]">{rev.productName}</p>
                <p class="text-[10px] text-[#8a5a3b]">{rev.category} · Lihat Produk →</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
