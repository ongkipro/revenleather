---
import { cardImageSrc } from '../../../lib/image-derivative';
import { isApprovedGrafirSlug } from '../../../lib/approved-grafir';

interface LandingPage {
  title: string;
  excerpt: string;
  image?: string;
  href?: string;
  crop?: string;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  pages: LandingPage[];
  heading: Heading;
  limit?: number;
}

const { pages, limit = 6 } = Astro.props;
const linked = pages.filter((page) => Boolean(page.href));
const visible = linked.slice(0, limit);
const hasMore = linked.length > visible.length;
---

{
  linked.length > 0 && (
    <section id="halaman" class="border-t border-[#dfd3c3] bg-[#faf6f1] px-4 py-8">
      <div class="mb-5 border-l-2 border-[#8a5a3b] pl-3.5 text-left">
        <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#8a5a3b]">
          Penawaran Eksklusif
        </span>
        <h2
          class="mt-1 text-[24px] font-semibold leading-tight text-[#1a1411]"
          style="font-family: 'Cormorant Garamond', Georgia, serif;"
        >
          Halaman Promo & Spesifikasi Lengkap
        </h2>
        <p class="mt-1 text-[12px] font-normal leading-relaxed text-[#5a4a3f]">
          Buka halaman penawaran produk untuk melihat detail kompartemen, pilihan warna kulit, dan form pemesanan langsung.
        </p>
      </div>

      <ul class="flex flex-col gap-2.5">
        {visible.map((page) => {
          const slug = (page.href || '').split('/').filter(Boolean).pop() || '';
          const hasGrafir = isApprovedGrafirSlug(slug);
          return (
            <li>
              <a
                href={page.href}
                class="flex min-h-16 items-center justify-between gap-3 rounded-xl border border-[#dfd3c3] bg-white p-2.5 transition-all hover:border-[#8a5a3b] hover:shadow-xs"
              >
                {page.image && (
                  <img
                    src={cardImageSrc(page.image)}
                    alt=""
                    width="52"
                    height="52"
                    loading="lazy"
                    decoding="async"
                    class="size-13 shrink-0 rounded-lg border border-[#ebe2d6] bg-[#f4eee6] object-cover"
                  />
                )}
                <span class="min-w-0 flex-1">
                  <span class="flex items-center gap-1.5">
                    <span class="truncate text-[13.5px] font-semibold text-[#1a1411]">{page.title}</span>
                    {hasGrafir && (
                      <span class="shrink-0 rounded bg-[#f4eee6] px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wider text-[#8a5a3b]">
                        ✦ Grafir
                      </span>
                    )}
                  </span>
                  <span class="mt-0.5 block truncate text-[11.5px] font-normal text-[#5a4a3f]">
                    {page.excerpt}
                  </span>
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-4 shrink-0 text-[#8a5a3b]"
                  aria-hidden="true"
                >
                  <path d="m9 18 6-6-6-6" />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>

      {hasMore && (
        <a
          href="/landing-page"
          class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-[#8a5a3b] bg-white px-6 text-[11px] font-bold uppercase tracking-[0.12em] text-[#1a1411] transition-colors hover:bg-[#1a1411] hover:text-[#f4eee6] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1a1411]"
        >
          Lihat Semua {linked.length} Halaman Penawaran →
        </a>
      )}
    </section>
  )
}
