---
import { cardImageSrc } from '../../../lib/image-derivative';

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
  href?: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides } = Astro.props;
---

<section class="bg-[#1a1411] text-[#f4eee6]">
  <h1 class="sr-only">{Astro.locals.tenant.defaultTitle}</h1>

  <div class="relative overflow-hidden bg-[#140f0d]">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out will-change-transform">
      {
        slides.map((slide, index) => (
          <article class="relative min-w-full">
            <img
              src={cardImageSrc(slide.image)}
              alt={`${slide.alt} - ${Astro.locals.tenant.name}`}
              title={slide.badge}
              width="480"
              height="480"
              class="aspect-square w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#140f0d] via-[#140f0d]/20 to-transparent" />
            <div class="absolute inset-x-0 bottom-0 p-5 pb-12 text-white">
              <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#d8b38c]">
                {slide.badge}
              </p>
              <div class="mt-1 flex items-end justify-between gap-3">
                <p
                  class="max-w-[18rem] text-[22px] font-semibold leading-tight text-white"
                  style="font-family: 'Cormorant Garamond', Georgia, serif;"
                >
                  {slide.text}
                </p>
                {slide.href ? (
                  <a
                    href={slide.href}
                    class="inline-flex shrink-0 items-center gap-1.5 border border-white/80 bg-[#1a1411]/85 px-3.5 py-2 text-[10.5px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-white hover:text-[#1a1411]"
                  >
                    <span>Lihat Produk</span>
                    <span aria-hidden="true">→</span>
                  </a>
                ) : (
                  <a
                    href="#produk"
                    class="inline-flex shrink-0 items-center gap-1.5 border border-white/80 bg-[#1a1411]/85 px-3.5 py-2 text-[10.5px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-white hover:text-[#1a1411]"
                  >
                    <span>Katalog</span>
                    <span aria-hidden="true">↓</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
    <div id="hero-dots" class="absolute bottom-2 left-5 z-10 flex items-end gap-2">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            class={index === 0
              ? 'h-8 w-7 border-b-2 border-white bg-transparent transition-colors focus-visible:outline-none'
              : 'h-8 w-4 border-b border-white/45 bg-transparent transition-colors hover:border-white focus-visible:outline-none'}
          />
        ))
      }
    </div>
  </div>

  <!-- 3-Column Store Highlights -->
  <div class="grid grid-cols-3 divide-x divide-[#2e241f] border-y border-[#2e241f] bg-[#1a1411] px-2 py-3 text-center">
    <div class="px-1.5">
      <p class="text-[10.5px] font-semibold uppercase tracking-[0.06em] text-white">100% Kulit Sapi</p>
      <p class="mt-0.5 text-[10px] text-[#b5a697]">Material Asli</p>
    </div>
    <div class="px-1.5">
      <p class="text-[10.5px] font-semibold uppercase tracking-[0.06em] text-white">Garansi 1 Tahun</p>
      <p class="mt-0.5 text-[10px] text-[#b5a697]">Jahitan & Resleting</p>
    </div>
    <div class="px-1.5">
      <p class="text-[10.5px] font-semibold uppercase tracking-[0.06em] text-white">Bisa COD</p>
      <p class="mt-0.5 text-[10px] text-[#b5a697]">QRIS · VA · Transfer</p>
    </div>
  </div>
</section>
