---
import ProductListItem from '../shared/ProductListItem.astro';
import Icon from '../shared/Icon.astro';
import { isApprovedGrafirSlug } from '../../../lib/approved-grafir';

interface Product {
  slug: string;
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants?: Array<{ label: string; price: number }>;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  products: Product[];
  heading: Heading;
}

const { products } = Astro.props;
const formatPrice = (val: number) => `Rp${val.toLocaleString('id-ID')}`;

const grafirCount = products.filter((p) => isApprovedGrafirSlug(p.slug)).length;

const categoryMap = new Map<string, number>();
for (const p of products) {
  const cat = (p.category || 'Lainnya').trim();
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
}
const categories = [...categoryMap.entries()].sort((a, b) => b[1] - a[1]);
---

<section id="produk" class="bg-[#faf6f1] px-4 py-6">
  <!-- Gratis Grafir Full-Image Showcase -->
  {
    grafirCount > 0 && (
      <div
        id="grafir-spotlight"
        class="mb-6 border border-[#2e241f] bg-[#1a1411] text-[#f4eee6]"
      >
        <div class="relative aspect-[16/9] w-full overflow-hidden border-b border-[#2e241f] bg-[#140f0d]">
          <img
            src="/images/reven-grafir-sample.webp"
            alt="Sampel Gratis Grafir Laser Reven Leather"
            width="640"
            height="360"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-center"
          />
          <div class="absolute right-3 top-3 border border-[#c89b72]/50 bg-[#1a1411]/90 px-2.5 py-1 text-[10px] font-semibold tracking-[0.08em] text-[#e5a970]">
            <s class="mr-1.5 font-normal text-[#b5a697]">Rp37.000</s>
            <span>GRATIS</span>
          </div>
        </div>

        <div class="p-4">
          <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-[#c89b72]">
            Layanan Gratis Grafir Laser
          </p>
          <h2
            class="mt-1 text-[20px] font-semibold leading-snug text-white"
            style="font-family: 'Cormorant Garamond', Georgia, serif;"
          >
            Gratis Ukir Nama / Inisial di {grafirCount} Produk Pilihan
          </h2>
          <p class="mt-1.5 text-[12px] leading-relaxed text-[#bfb2a3]">
            Berlaku untuk produk bertanda Gratis Grafir dengan metode pembayaran non-COD (Transfer Bank).
          </p>
          <button
            type="button"
            id="filter-grafir-cta"
            class="mt-3.5 inline-flex min-h-10 w-full cursor-pointer items-center justify-center gap-2 border border-[#c89b72] bg-[#c89b72] px-4 py-2 text-[11px] font-bold uppercase tracking-[0.1em] text-[#1a1411] transition-colors hover:bg-[#d8ae86]"
          >
            <span>Lihat {grafirCount} Produk Gratis Grafir</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    )
  }

  <!-- Catalog Heading -->
  <div class="mb-4 flex items-baseline justify-between border-b border-[#dcd2c6] pb-2.5">
    <h2
      class="text-[22px] font-semibold leading-none text-[#1a1411]"
      style="font-family: 'Cormorant Garamond', Georgia, serif;"
    >
      Katalog Produk
    </h2>
    <span class="text-[11px] font-medium text-[#6e5f52]">{products.length} Koleksi</span>
  </div>

  <!-- Search + Sharp Category Filter Tabs -->
  <div class="mb-5 flex flex-col gap-2.5" hidden={products.length === 0}>
    <div class="relative w-full">
      <input
        type="text"
        id="catalog-search"
        placeholder="Cari tas, handbag, clutch, dompet, atau sabuk..."
        aria-label="Cari produk"
        class="min-h-10 w-full rounded-none border border-[#cfc3b4] bg-white py-2 pl-9 pr-4 text-[13px] text-[#1a1411] transition-colors placeholder:text-[#8a7e72] focus:border-[#1a1411] focus:outline-none"
      />
      <Icon
        name="lucide:search"
        class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[#6e5f52]"
        aria-hidden="true"
      />
    </div>

    <div
      id="catalog-filter-pills"
      role="tablist"
      aria-label="Filter kategori produk"
      class="flex items-center gap-1.5 overflow-x-auto pb-1 pt-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <button
        type="button"
        role="tab"
        data-filter-pill="all"
        aria-selected="true"
        class="catalog-pill is-active inline-flex min-h-8 shrink-0 cursor-pointer items-center gap-1 rounded-none border border-[#1a1411] bg-[#1a1411] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.06em] text-white transition-colors"
      >
        <span>Semua ({products.length})</span>
      </button>

      {
        grafirCount > 0 && (
          <button
            type="button"
            role="tab"
            data-filter-pill="__grafir__"
            aria-selected="false"
            class="catalog-pill inline-flex min-h-8 shrink-0 cursor-pointer items-center gap-1 rounded-none border border-[#8a5a3b] bg-[#f4eee6] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.06em] text-[#5c3a21] transition-colors hover:bg-[#ebe1d4]"
          >
            <span>Gratis Grafir ({grafirCount})</span>
          </button>
        )
      }

      {
        categories.map(([cat, count]) => (
          <button
            type="button"
            role="tab"
            data-filter-pill={cat}
            aria-selected="false"
            class="catalog-pill inline-flex min-h-8 shrink-0 cursor-pointer items-center gap-1 rounded-none border border-[#cfc3b4] bg-white px-3 py-1 text-[11px] font-medium uppercase tracking-[0.06em] text-[#4a3f36] transition-colors hover:border-[#1a1411] hover:text-[#1a1411]"
          >
            <span>{cat} ({count})</span>
          </button>
        ))
      }
    </div>
  </div>

  {
    products.length === 0 && (
      <div class="border border-[#cfc3b4] bg-white px-5 py-10 text-center">
        <p class="text-[13px] font-semibold text-[#1a1411]">Katalog sedang disiapkan</p>
        <p class="mx-auto mt-2 max-w-[26rem] text-[12px] leading-6 text-[#5a4a3f]">
          Belum ada produk yang diterbitkan.
        </p>
      </div>
    )
  }

  <div id="product-grid" class="grid grid-cols-2 items-start gap-3" hidden={products.length === 0}>
    {
      products.map((product, idx) => {
        const hasGrafir = isApprovedGrafirSlug(product.slug);
        return (
          <div
            class:list={['product-card [content-visibility:auto] [contain-intrinsic-size:auto_265px]', idx >= 12 && 'hidden']}
            data-category={product.category}
            data-grafir={hasGrafir ? 'true' : 'false'}
            data-search={`${product.name} ${product.category} ${product.description} ${hasGrafir ? 'gratis grafir laser nama' : ''}`.toLowerCase()}
            data-index={idx}
          >
            <ProductListItem
              product={{
                slug: product.slug,
                productName: product.name,
                heroImage: product.image,
                category: product.category,
                price: product.price,
                comparePrice: product.comparePrice,
                variants: product.variants ?? [],
              }}
              formatPrice={formatPrice}
            />
          </div>
        );
      })
    }
  </div>

  <div
    id="load-more-container"
    class="mt-7 flex flex-col items-center gap-3"
    hidden={products.length === 0}
  >
    <p id="catalog-status" class="text-[11.5px] font-normal text-[#5a4a3f]">
      Menampilkan <span id="product-visible-count" class="font-semibold text-[#1a1411]">{Math.min(12, products.length)}</span> dari <span id="product-total-count" class="font-semibold text-[#1a1411]">{products.length}</span> produk
    </p>
    {
      products.length > 12 && (
        <button
          type="button"
          id="load-more-btn"
          class="inline-flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-none border border-[#1a1411] bg-[#1a1411] px-6 py-2.5 text-[11px] font-bold uppercase tracking-[0.12em] text-white transition-colors hover:bg-[#2c221d]"
        >
          <span>Tampilkan Produk Lainnya</span>
          <Icon name="lucide:chevron-down" class="h-4 w-4" aria-hidden="true" />
        </button>
      )
    }
  </div>
</section>

<script>
  function initProductCatalog() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const pills = document.querySelectorAll('[data-filter-pill]') as NodeListOf<HTMLButtonElement>;
    const grafirCta = document.getElementById('filter-grafir-cta');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('product-visible-count');
    const totalCountEl = document.getElementById('product-total-count');

    let currentSearch = '';
    let currentFilter = 'all';
    let visibleLimit = 12;

    function syncPillStyles() {
      pills.forEach((pill) => {
        const active = (pill.getAttribute('data-filter-pill') || 'all') === currentFilter;
        pill.setAttribute('aria-selected', String(active));
        if (active) {
          pill.className =
            'catalog-pill is-active inline-flex min-h-8 shrink-0 cursor-pointer items-center gap-1 rounded-none border border-[#1a1411] bg-[#1a1411] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.06em] text-white transition-colors';
        } else if (pill.getAttribute('data-filter-pill') === '__grafir__') {
          pill.className =
            'catalog-pill inline-flex min-h-8 shrink-0 cursor-pointer items-center gap-1 rounded-none border border-[#8a5a3b] bg-[#f4eee6] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.06em] text-[#5c3a21] transition-colors hover:bg-[#ebe1d4]';
        } else {
          pill.className =
            'catalog-pill inline-flex min-h-8 shrink-0 cursor-pointer items-center gap-1 rounded-none border border-[#cfc3b4] bg-white px-3 py-1 text-[11px] font-medium uppercase tracking-[0.06em] text-[#4a3f36] transition-colors hover:border-[#1a1411] hover:text-[#1a1411]';
        }
      });
    }

    function filterAndRender() {
      let matchedCount = 0;
      let currentlyShown = 0;

      cards.forEach((card) => {
        const searchData = card.getAttribute('data-search') || '';
        const category = card.getAttribute('data-category') || '';
        const isGrafir = card.getAttribute('data-grafir') === 'true';

        const matchesSearch = !currentSearch || searchData.includes(currentSearch);
        const matchesCategory =
          currentFilter === 'all' ||
          (currentFilter === '__grafir__' ? isGrafir : category === currentFilter);

        const matches = matchesSearch && matchesCategory;
        if (matches) matchedCount++;

        const show = matches && currentlyShown < visibleLimit;
        if (show) currentlyShown++;
        card.classList.toggle('hidden', !show);
      });

      if (visibleCountEl) visibleCountEl.textContent = String(currentlyShown);
      if (totalCountEl) totalCountEl.textContent = String(matchedCount);

      if (loadMoreBtn) {
        loadMoreBtn.style.display = currentlyShown >= matchedCount ? 'none' : 'inline-flex';
      }
    }

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        currentFilter = pill.getAttribute('data-filter-pill') || 'all';
        visibleLimit = 12;
        syncPillStyles();
        filterAndRender();
      });
    });

    grafirCta?.addEventListener('click', () => {
      currentFilter = '__grafir__';
      visibleLimit = 12;
      syncPillStyles();
      filterAndRender();
      document.getElementById('catalog-filter-pills')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      visibleLimit = 12;
      filterAndRender();
    });

    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += 12;
      filterAndRender();
    });

    filterAndRender();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductCatalog);
  } else {
    initProductCatalog();
  }
</script>
