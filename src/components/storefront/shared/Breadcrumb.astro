---
import { cn } from '../../../lib/cn';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const rail = 'max-w-[480px]';
---

<nav aria-label="Breadcrumb" class="border-b border-[#dfd3c3] bg-[#f4eee6] px-4 py-1.5">
  <div
    class={cn(
      'mx-auto flex min-w-0 items-center gap-1.5 overflow-hidden text-[11px] text-[#574c43]',
      rail,
    )}
  >
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;

        return (
          <>
            {index > 0 && <span class="shrink-0 text-[#9c8d7e]">/</span>}
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="inline-flex min-h-6 shrink-0 items-center font-medium text-[#574c43] transition-colors hover:text-[#1a1411]"
              >
                {item.label}
              </a>
            ) : (
              <span
                class="min-w-0 max-w-[65%] truncate font-semibold text-[#8a5a3b]"
                aria-current={isLast ? 'page' : undefined}
              >
                {item.label}
              </span>
            )}
          </>
        );
      })
    }
  </div>
</nav>
