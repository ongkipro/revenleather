---
import SiteBrand from './SiteBrand.astro';

const footerLinks = [
  { label: 'Katalog', href: '/produk' },
  { label: 'Tentang', href: '/tentang' },
  { label: 'Ulasan', href: '/testimoni' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Pengiriman', href: '/pengiriman' },
  { label: 'Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat', href: '/syarat-ketentuan' },
];
---

<footer class="border-t border-[#2e241f] bg-[#1a1411] px-5 py-9 text-[#f4eee6]">
  <div class="mx-auto flex max-w-[480px] flex-col items-center text-center">
    <SiteBrand href="/" tone="light" showTagline={false} />

    <p class="mt-2.5 max-w-[22rem] text-[11.5px] leading-relaxed text-[#b5a697]">
      100% Kulit Sapi Asli · Gudang Utama Bululawang, Kab. Malang
    </p>

    <nav
      aria-label="Tautan footer"
      class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border-y border-[#2e241f] py-3.5 text-[11px] font-medium uppercase tracking-[0.08em] text-[#cfc2b4] w-full"
    >
      {
        footerLinks.map((item) => (
          <a
            href={item.href}
            class="transition-colors hover:text-white focus-visible:outline-none"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <p class="mt-5 text-[10.5px] tracking-[0.06em] text-[#8a7c6f]">
      © {new Date().getFullYear()} {Astro.locals.tenant.name} · PT East Retail Network
    </p>
  </div>
</footer>
