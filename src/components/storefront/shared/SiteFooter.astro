---
import SiteBrand from './SiteBrand.astro';

const footerLinks = [
  { label: 'Katalog', href: '/produk' },
  { label: 'Pengiriman', href: '/pengiriman' },
  { label: 'Tentang', href: '/tentang' },
  { label: 'Kontak', href: '/kontak' },
];
---

<footer class="border-t border-[#2e241f] bg-[#1a1411] px-5 py-9 text-[#f4eee6]">
  <div class="mx-auto flex max-w-[480px] flex-col items-center text-center">
    <SiteBrand href="/" tone="light" showTagline={false} />

    <p class="mt-2.5 max-w-[22rem] text-[11.5px] leading-relaxed text-[#b5a697]">
      100% Kulit Sapi Asli · Gudang Utama Bululawang, Kab. Malang
    </p>

    <nav
      aria-label="Tautan footer"
      class="mt-5 flex w-full flex-wrap items-center justify-center gap-x-5 gap-y-2 border-y border-[#2e241f] py-3.5 text-[11px] font-medium uppercase tracking-[0.08em] text-[#cfc2b4]"
    >
      {
        footerLinks.map((item) => (
          <a
            href={item.href}
            class="transition-colors hover:text-white focus-visible:outline-none"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-5 flex flex-col items-center gap-1.5 text-[10.5px] tracking-[0.04em] text-[#8a7c6f]">
      <p>© {new Date().getFullYear()} {Astro.locals.tenant.name} · PT East Retail Network</p>
      <div class="flex flex-wrap items-center justify-center gap-2 text-[#a69788]" aria-label="Tautan legal">
        <a
          href="/kebijakan-privasi"
          class="transition-colors hover:text-[#f4eee6] focus-visible:outline-none"
        >
          Kebijakan Privasi
        </a>
        <span class="text-[#4a3b32]" aria-hidden="true">·</span>
        <a
          href="/syarat-ketentuan"
          class="transition-colors hover:text-[#f4eee6] focus-visible:outline-none"
        >
          Syarat &amp; Ketentuan
        </a>
        <span class="text-[#4a3b32]" aria-hidden="true">·</span>
        <a
          href="/sitemap"
          class="transition-colors hover:text-[#f4eee6] focus-visible:outline-none"
        >
          Sitemap
        </a>
      </div>
    </div>
  </div>
</footer>
