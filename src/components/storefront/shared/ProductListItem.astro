---
import { cardImageSrc } from '../../../lib/image-derivative';
import { isApprovedGrafirSlug } from '../../../lib/approved-grafir';

interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
  eager?: boolean;
}

const { product, formatPrice, eager = false } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
const hasGrafir = isApprovedGrafirSlug(product.slug);
---

<article class="group border border-[#d6cbbd] bg-white transition-colors hover:border-[#1a1411]">
  <a
    href={`/produk/${product.slug}`}
    class="flex flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1a1411]"
  >
    <div class="relative aspect-square overflow-hidden border-b border-[#ebe3d8] bg-[#f4eee6]">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
      {discountPercentage > 0 && (
        <span class="absolute left-0 top-0 bg-[#9e2a2b] px-2 py-0.5 text-[9.5px] font-bold uppercase tracking-[0.06em] text-white">
          -{discountPercentage}%
        </span>
      )}
      {hasGrafir && (
        <span class="absolute bottom-0 left-0 bg-[#1a1411]/90 px-2 py-0.5 text-[9px] font-semibold uppercase tracking-[0.08em] text-[#e5a970]">
          Gratis Grafir
        </span>
      )}
    </div>

    <div class="p-2.5">
      <p class="truncate text-[9.5px] font-medium uppercase tracking-[0.12em] text-[#7c6a5a]">
        {product.category}
      </p>
      <h2 class="mt-0.5 line-clamp-2 text-[13px] font-semibold leading-[1.35] text-[#1a1411]">
        {product.productName}
      </h2>

      <div class="mt-1.5 flex flex-wrap items-baseline gap-1.5">
        <p class="text-[14px] font-bold leading-none text-[#1a1411]">{formatPrice(product.price)}</p>
        {hasDiscount && (
          <p class="text-[10.5px] leading-none text-[#8c7f73] line-through">
            {formatPrice(comparePrice)}
          </p>
        )}
      </div>
    </div>
  </a>
</article>
