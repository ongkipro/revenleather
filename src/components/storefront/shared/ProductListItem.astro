---
import { cardImageSrc } from '../../../lib/image-derivative';
import { isApprovedGrafirSlug } from '../../../lib/approved-grafir';

interface ProductVariant {
  id?: string;
  label?: string;
  price?: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
  eager?: boolean;
}

const { product, formatPrice, eager = false } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
const hasGrafir = isApprovedGrafirSlug(product.slug);
---

<article class="group h-full overflow-hidden rounded-xl border border-[#dfd3c3] bg-white shadow-[0_2px_10px_rgba(26,20,17,0.04)] transition-all hover:border-[#8a5a3b] hover:shadow-[0_8px_22px_rgba(26,20,17,0.09)]">
  <a
    href={`/produk/${product.slug}`}
    class="flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1a1411]"
  >
    <div class="relative aspect-square overflow-hidden border-b border-[#ebe2d6] bg-[#f4eee6]">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
      {discountPercentage > 0 && (
        <span class="absolute left-2 top-2 rounded-md bg-[#9e2a2b] px-2 py-0.5 text-[9.5px] font-bold uppercase tracking-[0.08em] text-white shadow-xs">
          Hemat {discountPercentage}%
        </span>
      )}
      {hasGrafir && (
        <span class="absolute bottom-2 left-2 inline-flex items-center rounded-md border border-[#c89b72]/45 bg-[#1a1411]/90 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[0.08em] text-[#e5a970] backdrop-blur-xs">
          Gratis Grafir
        </span>
      )}
    </div>

    <div class="flex flex-1 flex-col p-3">
      <div class="flex items-center justify-between gap-1.5 text-[9.5px] font-bold uppercase tracking-[0.12em] text-[#8a5a3b]">
        <span class="min-w-0 truncate">{product.category}</span>
        <span class="shrink-0 font-semibold text-[#76685b]">{product.variants.length} warna</span>
      </div>
      <h2 class="mt-1.5 line-clamp-2 min-h-10 text-[13.5px] font-semibold leading-5 text-[#1a1411] group-hover:text-[#8a5a3b]">
        {product.productName}
      </h2>

      <div class="mt-auto pt-2.5">
        <div class="flex flex-wrap items-baseline gap-1.5">
          <p class="text-[14.5px] font-extrabold leading-5 text-[#1a1411]">{formatPrice(product.price)}</p>
          {hasDiscount && (
            <p class="text-[10.5px] leading-4 text-[#8a7e72] line-through">
              {formatPrice(comparePrice)}
            </p>
          )}
        </div>
        <div class="mt-2 flex items-center justify-between border-t border-[#f0e8de] pt-2 text-[10.5px] font-semibold text-[#8a5a3b]">
          <span>Lihat Produk</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </div>
      </div>
    </div>
  </a>
</article>
