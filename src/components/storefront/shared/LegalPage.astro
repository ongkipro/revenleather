---
import PageIntro from './PageIntro.astro';

interface LegalSection {
  title: string;
  paragraphs: string[];
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  sections: LegalSection[];
  breadcrumbs?: BreadcrumbItem[];
}

const { badge, title, description, sections, breadcrumbs = [] } = Astro.props;
---

<main id="konten-utama" class="min-h-screen bg-[#faf6f1] text-[#1a1411]">
  <PageIntro badge={badge} title={title} description={description} breadcrumbs={breadcrumbs} />

  <section class="mx-auto max-w-[480px] px-4 py-6">
    <slot name="before" />
    <div class="divide-y divide-[#dcd2c6] border border-[#d6cbbd] bg-white">
      {
        sections.map((section) => (
          <article class="p-5">
            <h2 class="font-serif text-[18px] font-semibold tracking-[-0.01em] text-[#1a1411]">
              {section.title}
            </h2>
            <div class="mt-2.5 space-y-3 text-[13px] leading-[1.7] text-[#574c43]">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
    <slot name="after" />
  </section>
</main>
