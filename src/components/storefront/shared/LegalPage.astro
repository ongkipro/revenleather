---
import PageIntro from './PageIntro.astro';

interface LegalSection {
  title: string;
  paragraphs: string[];
}

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  sections: LegalSection[];
  breadcrumbs?: BreadcrumbItem[];
}

const { badge, title, description, sections, breadcrumbs = [] } = Astro.props;
---

<main id="konten-utama" class="min-h-screen bg-[#faf6f1] text-[#1a1411]">
  <PageIntro badge={badge} title={title} description={description} breadcrumbs={breadcrumbs} />

  <section class="mx-auto max-w-[480px] px-4 py-7">
    <slot name="before" />
    <div class="space-y-4">
      {
        sections.map((section, idx) => (
          <article class="rounded-xl border border-[#dfd3c3] bg-white p-5 shadow-[0_2px_10px_rgba(26,20,17,0.03)]">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[#f4eee6] text-[10px] font-bold text-[#8a5a3b]">
                {idx + 1}
              </span>
              <h2 class="font-serif text-[18px] font-bold tracking-[-0.01em] text-[#1a1411]">
                {section.title}
              </h2>
            </div>
            <div class="mt-3 space-y-3 text-[13px] leading-[1.7] text-[#574c43]">
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
    <slot name="after" />
  </section>
</main>
