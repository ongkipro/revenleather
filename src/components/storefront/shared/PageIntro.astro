---
import { cn } from '../../../lib/cn';
import Breadcrumb from './Breadcrumb.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  badge: string;
  title: string;
  description: string;
  breadcrumbs?: BreadcrumbItem[];
}

const { badge, title, description, breadcrumbs = [] } = Astro.props;
const rail = 'max-w-[480px]';
---

{breadcrumbs.length > 0 && <Breadcrumb items={breadcrumbs} />}
<section class="border-b border-[#d6cbbd] bg-[#f4eee6] px-4 py-6">
  <div class={cn('mx-auto', rail)}>
    <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#7c6a5a]">
      {badge}
    </p>
    <h1 class="mt-1.5 font-serif text-[25px] font-semibold leading-[1.15] tracking-[-0.01em] text-[#1a1411]">
      {title}
    </h1>
    <p class="mt-2 max-w-[32rem] text-[12.5px] leading-[1.65] text-[#574c43]">{description}</p>
  </div>
</section>
