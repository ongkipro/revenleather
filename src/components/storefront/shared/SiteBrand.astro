---
interface Props {
  href?: string;
  class?: string;
  tone?: 'light' | 'dark' | 'glossy';
  showTagline?: boolean;
}

const { href = '/', class: className = '', tone = 'dark', showTagline = false } = Astro.props;
const isLight = tone === 'light';
const textClass = isLight ? 'text-white' : 'text-[#1a1411]';
const subTextClass = isLight ? 'text-[#d8c7b4]' : 'text-[#6e5a49]';

const storeName = Astro.locals.tenant.name.trim();
const [leadWord = '', ...restWords] = storeName.split(/\s+/);
const trailingWords = restWords.join(' ');
const tagline = Astro.locals.tenant.tagline?.trim() ?? '';
const monogram = (leadWord[0] ?? 'R').toUpperCase();
const brandMark = Astro.locals.tenant.brandMark;
---

<a
  href={href}
  class={`group inline-flex min-h-11 items-center gap-2.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#c89b72] ${className}`}
  aria-label={Astro.locals.tenant.name}
  title={Astro.locals.tenant.defaultTitle}
>
  {
    brandMark ? (
      <img
        src={brandMark}
        alt=""
        width="26"
        height="28"
        class:list={[
          'shrink-0 object-contain',
          isLight && 'brightness-0 invert',
        ]}
        loading="eager"
        decoding="async"
      />
    ) : (
      <span
        aria-hidden="true"
        data-monogram={monogram}
        class={`site-brand-monogram flex h-7 w-7 items-center justify-center bg-transparent text-[14px] font-bold tracking-widest ${textClass} transition-colors`}
        style="font-family: 'Cormorant Garamond', 'Cinzel', Georgia, serif;"
      ></span>
    )
  }

  <span class="flex flex-col justify-center text-left">
    <span
      class={`whitespace-nowrap text-[16px] font-semibold uppercase tracking-[0.22em] leading-none ${textClass}`}
      style="font-family: 'Cormorant Garamond', 'Cinzel', Georgia, serif;"
    >
      {leadWord}{trailingWords && <> <span class={`font-normal ${subTextClass}`}>{trailingWords}</span></>}
    </span>
    {
      showTagline && tagline && (
        <span
          class={`mt-1 text-[9px] font-normal uppercase tracking-[0.18em] ${isLight ? 'text-[#b5a697]' : 'text-[#76685b]'}`}
          style="font-family: Inter, sans-serif;"
        >
          {tagline}
        </span>
      )
    }
  </span>
</a>

<style>
  .site-brand-monogram::before {
    content: attr(data-monogram);
  }
</style>
